APP_NAME=PhysioDesk API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

DATABASE_URL=postgresql+psycopg://physiodesk:physiodesk@127.0.0.1:5432/physiodesk

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth (generate a new JWT_SECRET_KEY for production)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
