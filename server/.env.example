# PhysioDesk API — copy to .env and adjust as needed
APP_NAME=PhysioDesk API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

# Must match docker-compose Postgres credentials (repo root .env)
DATABASE_URL=postgresql+psycopg://physiodesk:physiodesk@127.0.0.1:5432/physiodesk

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
